# ─────────────────────────────────────────────────────────────────────
# Real Leveling — Environment Variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.
# All EXPO_PUBLIC_ variables are bundled into the app.
# All non-EXPO_PUBLIC_ variables are only available server-side / CI.
# ─────────────────────────────────────────────────────────────────────

# ──────────────────────────────
# Supabase (required)
# ──────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ──────────────────────────────
# RevenueCat (required)
# ──────────────────────────────
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-key

# ──────────────────────────────
# PostHog Analytics (required)
# ──────────────────────────────
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ──────────────────────────────
# Sentry (required in production)
# ──────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ──────────────────────────────
# App Environment
# ──────────────────────────────
# Values: development | preview | production
EXPO_PUBLIC_APP_ENV=development
